{
    $schema: 'vendor/infection/infection/resources/schema.json',
    source: {
        directories: ['src'],
    },
    // The PhpPgAdmin namespace is loaded by autoload.php, not by Composer.
    bootstrap: 'autoload.php',
    logs: {
        text: 'infection/infection.log',
        html: 'infection/infection.html',
        summary: 'infection/summary.log',
        // Sends the report to the Stryker Dashboard, which serves the mutation score badge in README.md. Infection only
        // sends it from CI builds of main that are no pull request builds, and only with STRYKER_DASHBOARD_API_KEY set.
        stryker: {
            report: 'main',
        },
    },
    mutators: {
        '@default': true,
    },
    // The current value, so it can only go up: raise it whenever tests kill more mutants.
    minCoveredMsi: 85,
    // Pull requests only mutate the lines they change (see php.yml); lines that give no mutants leave no MSI to check.
    ignoreMsiWithNoMutations: true,
    // Infection skips a mutant, without a warning, when even its fastest test runs longer than this. It takes a test's
    // time from its whole test class, and Tests/Integration/Database/PhpPgAdminConnectionTest runs about 20 seconds
    // on some machines, longer than the default of 10 seconds.
    timeout: 60,
}
